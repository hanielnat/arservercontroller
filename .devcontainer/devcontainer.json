{
  "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-azuretools.vscode-containers",
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "bradlc.vscode-tailwindcss",
        "tamasfe.even-better-toml",
        "oxc.oxc-vscode"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2.12.4": {
      "azureDnsAutoDetection": true
    },
    "ghcr.io/devcontainers/features/node:1.6.3": {
      "version": "24.10.0"
    },
    "ghcr.io/devcontainers-extra/features/uv:1.0.0": {},
    "ghcr.io/devcontainers-extra/features/bun:1.0.0": {}
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },
  "portsAttributes": {
    "5173": {
      "label": "Frontend",
      "onAutoForward": "openPreview"
    },
    "8000": {
      "label": "Backend",
      "onAutoForward": "openBrowser"
    }
  },
  "forwardPorts": [5173, 8000],
  "postCreateCommand": "bash ./.devcontainer/install-dependencies.sh",
  "remoteUser": "vscode",
  "runArgs": ["--privileged"]
}

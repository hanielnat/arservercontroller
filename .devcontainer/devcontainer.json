{
    "image": "mcr.microsoft.com/devcontainers/python:3.13",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "backend/.venv/bin/python"
            },
            "extensions": [
                "chneau.resource-monitor",
                "ms-azuretools.vscode-containers",
                "Vue.volar",
                "ms-python.python",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "njpwerner.autodocstring"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/node": {
            "version": "28.4.0"
        },
        "ghcr.io/devcontainers-extra/features/bun": {},
        "ghcr.io/devcontainers-extra/features/uv": {},
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "azureDnsAutoDetection": true
        }
    },
    "containerEnv": {
        "UV_LINK_MODE": "copy"
    },
    "portsAttributes": {
        "3000": {
            "label": "Frontend",
            "onAutoForward": "openPreview"
        },
        "8000": {
            "label": "Backend",
            "onAutoForward": "openBrowser"
        }
    },
    "forwardPorts": [
        8000,
        2555
    ],
    "postCreateCommand": "chmod +x ./.devcontainer/install-dependencies.sh && ./.devcontainer/install-dependencies.sh",
    "remoteUser": "vscode",
    "runArgs": [
        "--privileged",
        "-p",
        "2555:2555/udp",
        "-p",
        "18989:18989/udp",
        "-p",
        "18787:18787/tcp"
    ]
}
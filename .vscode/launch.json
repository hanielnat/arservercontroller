{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run module tests",
            "cwd": "${workspaceFolder}/backend",
            "type": "debugpy",
            "request": "launch",
            "module": "tests"
        },
        {
            "name": "Run module main",
            "cwd": "${workspaceFolder}/backend",
            "type": "debugpy",
            "request": "launch",
            "module": "arservercontroller.main"
        },
        {
            "name": "Run with uvicorn",
            "cwd": "${workspaceFolder}/backend/arservercontroller",
            "type": "debugpy",
            "request": "launch",
            "envFile": "${workspaceFolder}/.env",
            "python": "${command:python.interpreterPath}",
            "module": "uvicorn",
            "args": [
                "arservercontroller.main:app",
            ]
        },
        {
            "name": "Run with fastapi",
            "cwd": "${workspaceFolder}/backend/arservercontroller",
            "type": "debugpy",
            "request": "launch",
            "envFile": "${workspaceFolder}/.env",
            "python": "${command:python.interpreterPath}",
            "module": "fastapi",
            "args": [
                "dev"
            ]
        },
        {
            "name": "Run agent",
            "type": "go",
            "request": "launch",
            "envFile": "${workspaceFolder}/.env",
            "program": "${workspaceFolder}/backend/agent-service"
        }
    ]
}
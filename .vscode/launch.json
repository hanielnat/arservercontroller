{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: uvicorn",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/apps/server",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ENVIRONMENT": "development",
        "HOST": "0.0.0.0",
        "PORT": "8000"
      },
      "args": ["arservercontroller.main:app", "--host", "0.0.0.0", "--port", "8000"]
    },
    {
      "name": "API tests: pytest",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ENVIRONMENT": "testing"
      },
      "args": ["apps/server/tests"]
    }
  ]
}

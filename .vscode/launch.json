{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Module tests",
            "cwd": "${workspaceFolder}/backend",
            "type": "debugpy",
            "request": "launch",
            "module": "tests"
        },
        {
            "name": "Python Debugger: Module main",
            "cwd": "${workspaceFolder}/backend",
            "type": "debugpy",
            "request": "launch",
            "module": "arservercontroller.main"
        },
        {
            "name": "Python Debugger: Run with fastapi",
            "cwd": "${workspaceFolder}/backend",
            "type": "debugpy",
            "request": "launch",
            "envFile": "${workspaceFolder}/.env",
            "module": "uvicorn",
            "args": [
                "${workspaceFolderBasename}.main:app",
                "--reload"
            ]
        },
    ]
}
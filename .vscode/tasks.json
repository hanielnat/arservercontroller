{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup workspace",
      "type": "shell",
      "command": "bun run setup",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build"
    },
    {
      "label": "Dev: API and Web",
      "type": "shell",
      "command": "bun run dev",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Dev: API",
      "type": "shell",
      "command": "bun run dev:server",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Dev: Web",
      "type": "shell",
      "command": "bun run dev:web",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Build workspace",
      "type": "shell",
      "command": "bun run build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build"
    },
    {
      "label": "Test API",
      "type": "shell",
      "command": "uv run --locked --package arservercontroller --group test pytest apps/server/tests",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test"
    },
    {
      "label": "Test Web",
      "type": "shell",
      "command": "bun run --cwd apps/web test --run",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test"
    },
    {
      "label": "Lint workspace",
      "type": "shell",
      "command": "bun run lint",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Format workspace",
      "type": "shell",
      "command": "bun run fmt",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Run database migrations",
      "type": "shell",
      "command": "bun run db:migrate",
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Build mock server image",
      "type": "shell",
      "command": "bash scripts/build-ar-mock-image.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build"
    }
  ]
}

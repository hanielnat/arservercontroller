{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Format",
            "type": "shell",
            "command": "./tasks.sh format",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": "build",
            "detail": "Formata o repositório com o Black."
        },
        {
            "label": "Lint",
            "type": "shell",
            "command": "./tasks.sh lint",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "detail": ""
        },
        {
            "label": "Format & test",
            "type": "shell",
            "command": "./tasks.sh check",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "detail": ""
        },
        {
            "label": "Install",
            "type": "shell",
            "command": "./tasks.sh install",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": "build",
            "detail": ""
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "./tasks.sh build",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": "build",
            "detail": ""
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "./tasks.sh clean",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "detail": "Remove o venv e arquivos cache/temporários do repositório."
        },
        {
            "label": "Run dev",
            "type": "shell",
            "command": "./tasks.sh run-dev",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "problemMatcher": [
                "$python"
            ]
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "./tasks.sh run",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "detail": ""
        },
        {
            "label": "Test",
            "type": "shell",
            "command": "./tasks.sh test",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "detail": ""
        }
    ]
}